<mxfile>
  <diagram name="K8s Cluster Architecture" id="k8s-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Kubernetes Cluster Architecture" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- Control Plane Box -->
        <mxCell id="cp-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="540" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="cp-label" value="Control Plane (Master)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="45" y="78" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- API Server -->
        <mxCell id="api" value="&lt;b&gt;kube-apiserver&lt;/b&gt;&lt;br&gt;REST API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b82f6;fontColor=#ffffff;strokeColor=#2563eb;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="115" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- etcd -->
        <mxCell id="etcd" value="&lt;b&gt;etcd&lt;/b&gt;&lt;br&gt;Key-Value Store" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fbbf24;fontColor=#1e293b;strokeColor=#f59e0b;fontSize=11;size=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="105" width="120" height="65" as="geometry"/>
        </mxCell>

        <!-- Controller Manager -->
        <mxCell id="cm" value="&lt;b&gt;controller-manager&lt;/b&gt;&lt;br&gt;Reconciliation Loops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8b5cf6;fontColor=#ffffff;strokeColor=#7c3aed;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- Scheduler -->
        <mxCell id="sched" value="&lt;b&gt;kube-scheduler&lt;/b&gt;&lt;br&gt;Pod Placement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8b5cf6;fontColor=#ffffff;strokeColor=#7c3aed;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="200" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- Cloud Controller -->
        <mxCell id="ccm" value="&lt;b&gt;cloud-controller&lt;/b&gt;&lt;br&gt;Cloud Provider API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8b5cf6;fontColor=#ffffff;strokeColor=#7c3aed;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="200" width="120" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrows from API -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="api" target="etcd" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#8b5cf6;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="api" target="cm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#8b5cf6;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="api" target="sched" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Worker Node 1 -->
        <mxCell id="w1-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=2;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="390" width="350" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="w1-label" value="Worker Node 1" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="45" y="398" width="150" height="25" as="geometry"/>
        </mxCell>

        <!-- kubelet -->
        <mxCell id="kubelet1" value="&lt;b&gt;kubelet&lt;/b&gt;&lt;br&gt;Node Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;strokeColor=#16a34a;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="430" width="130" height="50" as="geometry"/>
        </mxCell>

        <!-- kube-proxy -->
        <mxCell id="proxy1" value="&lt;b&gt;kube-proxy&lt;/b&gt;&lt;br&gt;Network Rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#06b6d4;fontColor=#ffffff;strokeColor=#0891b2;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="430" width="130" height="50" as="geometry"/>
        </mxCell>

        <!-- Container Runtime -->
        <mxCell id="cri1" value="&lt;b&gt;Container Runtime&lt;/b&gt;&lt;br&gt;containerd / CRI-O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748b;fontColor=#ffffff;strokeColor=#475569;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="290" height="40" as="geometry"/>
        </mxCell>

        <!-- Pods -->
        <mxCell id="pod1" value="🟢 Pod A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#22c55e;fontSize=11;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="55" y="560" width="85" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pod2" value="🟢 Pod B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#22c55e;fontSize=11;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="155" y="560" width="85" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pod3" value="🔵 Pod C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#3b82f6;fontSize=11;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="255" y="560" width="85" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pod-label" value="Pods (Containers)" style="text;html=1;fontSize=10;fontStyle=2;align=left;fillColor=none;strokeColor=none;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="55" y="605" width="120" height="20" as="geometry"/>
        </mxCell>

        <!-- Worker Node 2 -->
        <mxCell id="w2-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=2;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="390" width="350" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="w2-label" value="Worker Node 2" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="435" y="398" width="150" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="kubelet2" value="&lt;b&gt;kubelet&lt;/b&gt;&lt;br&gt;Node Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;strokeColor=#16a34a;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="430" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="proxy2" value="&lt;b&gt;kube-proxy&lt;/b&gt;&lt;br&gt;Network Rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#06b6d4;fontColor=#ffffff;strokeColor=#0891b2;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="430" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cri2" value="&lt;b&gt;Container Runtime&lt;/b&gt;&lt;br&gt;containerd / CRI-O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748b;fontColor=#ffffff;strokeColor=#475569;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="500" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pod4" value="🟠 Pod D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#f97316;fontSize=11;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="445" y="560" width="85" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pod5" value="🟣 Pod E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d5ff;strokeColor=#a855f7;fontSize=11;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="545" y="560" width="85" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pod6" value="🟢 Pod F" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#22c55e;fontSize=11;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="645" y="560" width="85" height="40" as="geometry"/>
        </mxCell>

        <!-- API to Worker connections -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#22c55e;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="api" target="kubelet1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#22c55e;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="api" target="kubelet2" parent="1">
