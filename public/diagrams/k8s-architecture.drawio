        <!-- Users -->
        <mxCell id="users" value="👤 Users / CI-CD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#94a3b8;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="users" target="kubectl" parent="1">
