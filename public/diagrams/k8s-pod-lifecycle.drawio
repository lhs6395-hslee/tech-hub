<mxfile>
  <diagram name="Pod Lifecycle" id="k8s-pod-lc">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Pod Lifecycle &amp; States" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- Pending -->
        <mxCell id="pending" value="&lt;b&gt;Pending&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Scheduling&lt;br&gt;Image Pull&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbbf24;fontColor=#1e293b;strokeColor=#f59e0b;fontSize=12;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="130" height="70" as="geometry"/>
        </mxCell>

        <!-- Running -->
        <mxCell id="running" value="&lt;b&gt;Running&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;At least 1 container&lt;br&gt;is running&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;strokeColor=#16a34a;fontSize=12;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- Succeeded -->
        <mxCell id="succeeded" value="&lt;b&gt;Succeeded&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;All containers&lt;br&gt;exited (0)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b82f6;fontColor=#ffffff;strokeColor=#2563eb;fontSize=12;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="130" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- Failed -->
        <mxCell id="failed" value="&lt;b&gt;Failed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Container exited&lt;br&gt;with error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#ffffff;strokeColor=#dc2626;fontSize=12;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="270" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- Unknown -->
        <mxCell id="unknown" value="&lt;b&gt;Unknown&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Node communication&lt;br&gt;lost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#94a3b8;fontColor=#ffffff;strokeColor=#64748b;fontSize=12;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="370" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- Create -->
        <mxCell id="create" value="kubectl apply" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=none;strokeColor=none;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="130" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="arrow-create" style="strokeColor=#f59e0b;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="125" y="150" as="sourcePoint"/>
            <mxPoint x="125" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Pending → Running -->
        <mxCell id="e1" value="Scheduled" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#22c55e;strokeWidth=2;fontSize=10;fontColor=#6b7280;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="pending" target="running" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Running → Succeeded -->
        <mxCell id="e2" value="Exit 0" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#3b82f6;strokeWidth=2;fontSize=10;fontColor=#6b7280;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="running" target="succeeded" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Running → Failed -->
        <mxCell id="e3" value="Exit ≠ 0" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#ef4444;strokeWidth=2;fontSize=10;fontColor=#6b7280;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="running" target="failed" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Running → Unknown -->
        <mxCell id="e4" value="Node Lost" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#94a3b8;strokeWidth=2;fontSize=10;fontColor=#6b7280;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="running" target="unknown" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Container Probes Box -->
        <mxCell id="probes-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="320" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="probes-title" value="Container Probes" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="735" y="88" width="150" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="startup" value="&lt;b&gt;startupProbe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;App initialized?&lt;br&gt;Disables other probes until success&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#fbbf24;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="120" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="liveness" value="&lt;b&gt;livenessProbe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Is container alive?&lt;br&gt;Fail → restart container&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="190" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="readiness" value="&lt;b&gt;readinessProbe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ready for traffic?&lt;br&gt;Fail → remove from Service endpoints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="260" width="280" height="50" as="geometry"/>
        </mxCell>

        <!-- Restart Policy Box -->
        <mxCell id="restart-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;strokeWidth=1;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="420" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="restart-title" value="restartPolicy" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="735" y="428" width="150" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="always" value="&lt;b&gt;Always&lt;/b&gt; (default)&lt;br&gt;Deployment, ReplicaSet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="735" y="460" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="onfailure" value="&lt;b&gt;OnFailure&lt;/b&gt;&lt;br&gt;Job, CronJob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="735" y="510" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="never" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;One-shot tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="460" width="140" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>