<mxfile>
  <diagram name="K8s Networking" id="k8s-net">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Kubernetes Networking Model" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 1: External Traffic ===== -->
        <mxCell id="client" value="🌐 Client / Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#0f172a;fontSize=12;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="180" height="45" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 2: Ingress ===== -->
        <mxCell id="ingress-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1;arcSize=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="130" width="440" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ingress" value="&lt;b&gt;Ingress Controller&lt;/b&gt; (nginx / traefik)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;L7 Routing: host/path → Service | TLS Termination&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8b5cf6;fontColor=#ffffff;strokeColor=#7c3aed;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="140" width="400" height="50" as="geometry"/>
        </mxCell>

        <!-- Client → Ingress -->
        <mxCell id="e-client-ingress" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#8b5cf6;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=9;fontColor=#6b7280;" edge="1" source="client" target="ingress" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 3: Service Types ===== -->
        <mxCell id="svc-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1;arcSize=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="230" width="1140" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="svc-label" value="Service Layer (kube-proxy: iptables / IPVS)" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="45" y="238" width="350" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="clusterip" value="&lt;b&gt;ClusterIP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Internal only (default)&lt;br&gt;Virtual IP → Endpoints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b82f6;fontColor=#ffffff;strokeColor=#2563eb;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="270" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="nodeport" value="&lt;b&gt;NodePort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ClusterIP + Node:30000-32767&lt;br&gt;External access via Node IP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#06b6d4;fontColor=#ffffff;strokeColor=#0891b2;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="270" width="185" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="loadbalancer" value="&lt;b&gt;LoadBalancer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;NodePort + Cloud LB&lt;br&gt;External IP auto-assigned&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;strokeColor=#16a34a;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="455" y="270" width="175" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="headless" value="&lt;b&gt;Headless&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;clusterIP: None&lt;br&gt;DNS returns Pod IPs directly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f59e0b;fontColor=#1e293b;strokeColor=#d97706;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="270" width="165" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="externalname" value="&lt;b&gt;ExternalName&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CNAME to external DNS&lt;br&gt;No proxy, no ClusterIP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a855f7;fontColor=#ffffff;strokeColor=#9333ea;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="855" y="270" width="165" height="55" as="geometry"/>
        </mxCell>

        <!-- Ingress → ClusterIP -->
        <mxCell id="e-ing-clusterip" value="route" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=9;fontColor=#6b7280;" edge="1" source="ingress" target="clusterip" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Client → NodePort (direct) -->
        <mxCell id="e-client-nodeport" value="Node:Port" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#06b6d4;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=9;fontColor=#6b7280;dashed=1;" edge="1" source="client" target="nodeport" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Client → LoadBalancer (direct) -->
        <mxCell id="e-client-lb" value="External IP" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#22c55e;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=9;fontColor=#6b7280;dashed=1;" edge="1" source="client" target="loadbalancer" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 4: Endpoints / Pod Network ===== -->
        <mxCell id="pod-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1;arcSize=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="380" width="750" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="pod-label" value="Pod Network (CNI: Calico / Flannel / Cilium)" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="45" y="388" width="350" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="ep" value="&lt;b&gt;Endpoints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Service → Pod IP:Port mapping&lt;br&gt;Auto-updated by controller&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#86efac;fontColor=#1e293b;strokeColor=#22c55e;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="180" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="pod-a" value="&lt;b&gt;Pod A&lt;/b&gt;&lt;br&gt;10.244.0.5:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#22c55e;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="420" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pod-b" value="&lt;b&gt;Pod B&lt;/b&gt;&lt;br&gt;10.244.1.3:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#22c55e;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pod-c" value="&lt;b&gt;Pod C&lt;/b&gt;&lt;br&gt;10.244.2.7:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#22c55e;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Service → Endpoints -->
        <mxCell id="e-svc-ep" value="VIP → Endpoints" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#22c55e;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=9;fontColor=#6b7280;" edge="1" source="clusterip" target="ep" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Endpoints → Pods -->
        <mxCell id="e-ep-a" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#22c55e;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" edge="1" source="ep" target="pod-a" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ep-b" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#22c55e;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;dashed=1;" edge="1" source="ep" target="pod-b" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ep-c" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#22c55e;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;dashed=1;" edge="1" source="ep" target="pod-c" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Pod-to-Pod direct -->
        <mxCell id="e-pod-direct" value="direct (no NAT)" style="strokeColor=#10b981;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;dashed=1;fontSize=9;fontColor=#6b7280;startArrow=blockThin;startFill=1;" edge="1" source="pod-a" target="pod-b" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 5: DNS ===== -->
        <mxCell id="dns-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#fde047;strokeWidth=1;arcSize=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="530" width="750" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="dns-label" value="CoreDNS — Cluster DNS" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#a16207;" vertex="1" parent="1">
          <mxGeometry x="45" y="538" width="200" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="dns-svc" value="&lt;b&gt;my-svc.default.svc.cluster.local&lt;/b&gt;&lt;br&gt;→ ClusterIP (10.96.x.x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fde047;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="230" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="dns-pod" value="&lt;b&gt;10-244-0-5.default.pod.cluster.local&lt;/b&gt;&lt;br&gt;→ Pod IP directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fde047;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="570" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="dns-headless" value="&lt;b&gt;Headless: returns all Pod IPs&lt;/b&gt;&lt;br&gt;A record per Pod (StatefulSet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fde047;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="570" width="190" height="45" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 5 (right): NetworkPolicy ===== -->
        <mxCell id="np-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;strokeWidth=1;arcSize=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="380" width="350" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="np-label" value="NetworkPolicy" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="835" y="388" width="150" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="np-desc" value="&lt;font style=&quot;font-size:10px&quot;&gt;Default: all traffic allowed&lt;br&gt;Once a policy selects a pod,&lt;br&gt;only explicitly allowed traffic passes&lt;/font&gt;" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="835" y="415" width="250" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="np-ingress" value="&lt;b&gt;ingress:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;- from: podSelector / namespaceSelector&lt;br&gt;- ports: [TCP/80, TCP/443]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="470" width="310" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="np-egress" value="&lt;b&gt;egress:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;- to: ipBlock (CIDR) / podSelector&lt;br&gt;- ports: [TCP/5432, TCP/6379]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;fontSize=10;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="535" width="310" height="50" as="geometry"/>
        </mxCell>

        <!-- NetworkPolicy → Pod -->
        <mxCell id="e-np-pod" value="filter" style="edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#ef4444;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=9;fontColor=#ef4444;" edge="1" source="np-ingress" target="pod-c" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>